# Archivo de ejemplo de configuración para pruebas de carga
# Copia este archivo como .env y configura los valores según tu entorno

# URL base de la API (sin trailing slash)
API_BASE_URL=https://tu-api-gateway.execute-api.us-east-2.amazonaws.com/prod

# API Key (si es requerida por tu API Gateway)
# Obtén la API Key usando: python get-api-key.py
API_KEY=tu-api-key-aqui

# Configuración de la prueba (opcional, valores por defecto en el script)
# USERS=100
# SPAWN_RATE=10
# RUN_TIME=5m

